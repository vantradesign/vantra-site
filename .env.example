# Supabase — scaffolded now, dormant until accounts/payments ship.
# @nuxtjs/supabase throws at startup if these are absent, so they are required
# even while no auth-gated feature exists. Placeholder values are fine for local
# development of the public site; no request is made unless a composable or a
# server route actually calls Supabase.
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_KEY=placeholder-anon-key

# Server-only. Never expose to the client. Used later by Nitro routes that need
# to bypass RLS (e.g. Stripe webhook -> subscription state).
# SUPABASE_SERVICE_KEY=

# Stripe — not yet wired. Documented here so the shape of the future
# integration is obvious. See README § Adding accounts and payments.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
